<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-Orion.MacroEconomics-74584683-eefb-43cc-b91a-d594f35753c9</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <!-- Marten (PostgreSQL Document DB + Event Store) -->
        <PackageReference Include="Marten" Version="8.37.0" />
        <PackageReference Include="Marten.CommandLine" Version="7.40.5" />

        <!-- EF Core with PostgreSQL (if you still need relational access) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.15" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

        <!-- MediatR for CQRS -->
        <PackageReference Include="MediatR" Version="14.1.0" />

        <!-- Authentication -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.15" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.15" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.Identity.Web" Version="3.0.0" />
        <PackageReference Include="Microsoft.Identity.Web.DownstreamApi" Version="3.0.0" />

        <!-- OpenAPI/Swagger -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.15" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />

        <!-- Yahoo Finance (choose ONE) -->
        <PackageReference Include="YahooQuotesApi" Version="7.0.8" />

        <!-- Technical Indicators -->
        <PackageReference Include="Skender.Stock.Indicators" Version="2.7.1" />

        <!-- Scheduling -->
        <PackageReference Include="Quartz" Version="3.18.1" />
        <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.1" />

        <!-- Resilience -->
        <PackageReference Include="Polly" Version="8.6.6" />
        <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />

        <!-- Email -->
        <PackageReference Include="MimeKit" Version="4.16.0" />

        <!-- JasperFx (required by Marten) -->
        <PackageReference Include="JasperFx.Core" Version="1.12.0" />
        <PackageReference Include="Quartz.Jobs" Version="3.18.1" />
        <PackageReference Include="Quartz" Version="3.18.1" />
        <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.18.1" />
        <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.1" />
        <PackageReference Include="Skender.Stock.Indicators" Version="2.7.1" />
        <PackageReference Include="YahooFinanceApi" Version="3.0.0-beta3" />
        <PackageReference Include="YahooQuotesApi" Version="7.0.8" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Remove unnecessary Quartz.Jobs if not using specific job implementations -->
        <!-- PackageReference Include="Quartz.Jobs" Version="3.18.1" / -->
    </ItemGroup>

    <ItemGroup>
        <!-- Exclude test project artifacts (only needed in solution root or Directory.Build.props) -->
        <_ContentIncludedByDefault Remove="Orion.MacroEconomics.UnitTests\obj\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Application\" />
    </ItemGroup>

</Project>